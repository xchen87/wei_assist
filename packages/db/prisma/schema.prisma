// Meridian data model.
//
// Production target is PostgreSQL (see ../../../DECISIONS.md D-001, D-014).
// This sandbox has no Postgres server available, so local dev/demo runs on
// SQLite. SQLite also has no native enum type, so fields that would be
// Postgres enums (segment, reviewStatus, goal status, pipeline stage) are
// plain strings here, constrained by TS union types at the app layer
// instead (see @meridian/db's exported types) — switching back to Postgres
// later means re-introducing real `enum` blocks, not a data migration.
//
// Scope: this is the seed/demo shape backing the screens actually
// implemented so far (Today, Clients, five household-detail sections,
// Prospects) — not the full data model implied by every mocked screen in
// design/. Money is integer minor units (cents) per D-007. Percentages are
// stored as plain floats on a 0-100 scale (6.1 means 6.1%), not basis points
// — simpler for a demo with no currency conversion or interest-rate math.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Advisor {
  id             String      @id @default(cuid())
  name           String
  initials       String
  capacityTarget Int // households this advisor is staffed to serve, for the Insights capacity bar
  households      Household[]
  prospects       Prospect[]
  dashboardLayout DashboardLayout?
  indicatorWatches IndicatorWatch[]
}

model Household {
  id        String  @id @default(cuid())
  name      String
  segment   String // Core | Premier | Founding
  advisor   Advisor @relation(fields: [advisorId], references: [id])
  advisorId String

  // Clients list columns
  aumCents        BigInt
  netWorthCents   BigInt
  heldAwayCents   BigInt
  ytdReturnPct    Float
  cashPct         Float
  targetCashPct   Float
  driftPct        Float
  planHealthPct   Int
  lastContactDays Int
  nextReviewDate  DateTime
  reviewStatus    String // scheduled | due | overdue
  clientSinceYear Int

  // Overview
  completenessPct Int
  whatChanged     String // newline-separated bullet lines; demo-only, not a real diff engine

  // Per-section completeness, shown in each PlanSection header's ring. Real
  // completeness (CLAUDE.md §6) comes from a required-field manifest, which
  // doesn't exist yet (see PROGRESS.md) — until then these are seeded to
  // vary plausibly per household rather than being one constant reused on
  // every section of every household, which was the actual bug: it read as
  // fabricated because it never changed.
  householdCompletenessPct  Int
  cashflowCompletenessPct   Int
  balanceCompletenessPct    Int
  allocationCompletenessPct Int
  goalsCompletenessPct      Int
  retirementCompletenessPct Int
  taxCompletenessPct        Int
  protectionCompletenessPct Int
  estateCompletenessPct     Int
  documentsCompletenessPct  Int
  activityCompletenessPct   Int
  // Unlike the eleven above, this one isn't seeded to "vary plausibly" — the
  // seed computes it from the household's own ComplianceItem rows and
  // attestation currency, which is the closest thing to a real required-field
  // manifest that exists anywhere in the app today. Still stored rather than
  // computed at render time, so every section reads its ring the same way.
  complianceCompletenessPct Int

  // Cashflow (annual, illustrative — see design/README.md conventions)
  incomeCents    BigInt
  taxesCents     BigInt
  netIncomeCents BigInt
  spendingCents  BigInt
  savingsCents   BigInt
  savingsRatePct Float

  // Balance (waterfall, past 12 months)
  balanceStartCents         BigInt
  balanceContributionsCents BigInt
  balanceGrowthCents        BigInt
  balanceTaxesCents         BigInt
  balanceSpendingCents      BigInt
  investmentAccountsCents   BigInt
  realEstateCents           BigInt
  cashCents                 BigInt
  otherAssetsCents          BigInt
  mortgageCents             BigInt

  // Allocation
  equityTargetPct        Float
  equityActualPct        Float
  fixedIncomeTargetPct   Float
  fixedIncomeActualPct   Float
  topHoldingName         String
  topHoldingTicker       String
  topHoldingPct          Float
  distinctHoldings       Int
  blendedExpenseRatioPct Float

  // Retirement (inputs to the Monte-Carlo-style projection in lib/calc/retirement.ts —
  // the fan chart itself is computed, not stored; see design/Retirement.dc.html)
  retirementAgePrimary      Int
  retirementAgeSpouse       Int? // null for single-member households
  ssClaimAgePrimary         Int
  ssClaimAgeSpouse          Int?
  monthlySpendingNeedCents  BigInt
  withdrawalSequencing      String // shared with Tax's "preferred withdrawal order" row
  retirementSuccessDeltaPts Int // change in success probability since last review — illustrative, like whatChanged

  // Tax — only the real inputs are stored; which bracket a household falls
  // in, how far through it, and room to the next one are all computed at
  // render time by lib/calc/tax.ts from taxableIncomeCents, against the six
  // illustrative bracket rates/widths defined once there (per
  // design/Tax.dc.html's own "illustrative for this draft" disclaimer).
  // Storing the derived position too would let it silently drift out of
  // sync with the bracket table if either ever changed independently.
  filingStatus           String // e.g. "Married filing jointly"
  taxableIncomeCents     BigInt
  effectiveRatePct       Float
  realizedGainsCents     BigInt
  unrealizedGainsCents   BigInt
  harvestableLossesCents BigInt

  // Activity
  openTasksCount Int

  members        Member[]
  goals          Goal[]
  insights       Insight[]
  policies       Policy[]
  estateAssets   EstateAsset[]
  estateDocs     EstateDocument[]
  documents      Document[]
  activityEvents ActivityEvent[]
  complianceItems ComplianceItem[]
  attestations    ReviewAttestation[]
  alerts          Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  name        String
  role        String // Primary | Spouse | Dependent
  age         Int
  occupation  String
  // From the intake questionnaire (lib/calc/risk.ts): Conservative,
  // Moderate, Growth or Aggressive. Null for members who predate intake or
  // whose questionnaire wasn't completed — an unanswered questionnaire has
  // no profile, rather than a default one.
  riskProfile String?
  // CLAUDE.md §11 lists dates of birth as masked-by-default PII. Shown in
  // full instead, per D-019: every user of this platform is a certified
  // professional and the whole record is confidential, so masking a
  // birthday from the advisor who owns the relationship is friction with no
  // threat model behind it. Still plaintext at rest — field-level
  // encryption is unbuilt (Phase 9). Seeded values are fictional and agree
  // with `age` at seed time; the two drift apart as real time passes, so
  // `age` stays the field everything but the roster reads.
  birthDate   DateTime?
}

model Goal {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  name        String
  priority    String // Low | Medium | High
  // Null on a goal captured at intake: the household has named the goal but
  // not costed it yet. Zero would claim a $0 target, which reads as fully
  // funded everywhere a percentage is computed.
  targetCents BigInt?
  fundedPct   Float
  status      String // onTrack | fullyFunded | behind | unset
  // "Under 3 years", "3–7 years", ... captured at intake (§6 lists goal
  // time horizons); null on the seeded households, which predate it.
  horizonLabel String?
}

model Insight {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  section     String // which PlanSection this belongs to
  text        String
  sourceLabel String
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Prospect {
  id            String   @id @default(cuid())
  name          String
  source        String // e.g. "Referral: Ramirez Household", "Web inquiry"
  estValueCents BigInt
  stage         String // Inquiry | Discovery | Proposal | Agreement
  daysInStage   Int
  stalled       Boolean  @default(false)
  advisor       Advisor  @relation(fields: [advisorId], references: [id])
  advisorId     String
  createdAt     DateTime @default(now())
}

// Protection: one row per coverage type, driving the diverging gap-bar chart.
// gapPct is what the bar plots directly (negative = underinsured, positive =
// overinsured, 0 = at target) — see design/Protection.dc.html. detailLabel is
// the free-text "Need X · Current Y" shown in the Detail table, since life
// insurance is dollar-denominated but disability is percent-denominated and
// a single pair of numeric columns can't represent both honestly.
model Policy {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  type        String // Life | Disability | LongTermCare | Umbrella | PropertyCasualty
  gapPct      Float? // null = "at target", drawn with no bar at all
  gapLabel    String? // e.g. "-40%", "-25pts", "+50%" — display form, sign-formatted per its own unit
  detailLabel String // e.g. "Need $2,000,000 · Current $1,200,000"
}

// Estate: each row is one edge in the asset -> beneficiary flow diagram.
model EstateAsset {
  id                 String    @id @default(cuid())
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId        String
  assetName          String
  beneficiaryLabel   String
  missingDesignation Boolean   @default(false)
  sortOrder          Int
}

model EstateDocument {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  name        String
  statusLabel String
  overdue     Boolean   @default(false)
  sortOrder   Int
}

// Household-scoped document vault (distinct from the top-level Documents
// page, which lists across all households).
model Document {
  id            String    @id @default(cuid())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId   String
  name          String
  type          String // Estate | Tax | Agreement | KYC | ...
  statusLabel   String // Signed | Filed | Due | Expiring soon | Missing
  bucket        String // complete | needsAttention | missing — drives the vault-status bar
  uploadedLabel String // formatted date string, or "—" for Missing
  source        String // Client-provided | E-signature | Advisor upload | "—"
}

model ActivityEvent {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  kind        String // Meeting | Document | TaskCompleted | Note | PlanChange
  label       String
  detail      String? // optional second line, e.g. meeting notes
  occurredAt  DateTime
}

// Household-scoped compliance record (CLAUDE.md §6 §14): the agreements,
// disclosures, and suitability artifacts that have to be in force for this
// household, one row each. Deliberately parallel to Document's vocabulary
// — same three buckets, same status-label-plus-bucket split — because the
// two surfaces overlap (the IPS appears in both) and disagreeing about
// whether it's signed would be worse than the duplication.
model ComplianceItem {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  name        String
  category    String // IPS | Suitability | Disclosure | Agreement
  statusLabel String // In force | Refresh due | Delivery due | Not on file
  bucket      String // inForce | needsAttention | missing — drives the readiness bar
  detail      String // what the item is, in an advisor's words
  effectiveLabel String // formatted date it took effect, or "—"
  nextDueLabel   String // formatted date it next comes due, or "—" if it doesn't recur
  sortOrder   Int
}

// One periodic review and whether it was attested. This is the compliance
// heartbeat the section's summary visual plots: a review that happened but
// was never attested is a real audit gap, distinct from one not yet held.
model ReviewAttestation {
  id          String    @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId String
  periodLabel String // e.g. "H1 2026" or "2025" depending on the household's cadence
  occurredAt  DateTime // the review date — in the future for the one not yet held
  held        Boolean // false for the upcoming (or missed) review
  attested    Boolean // a held review can still be unattested; that's the gap worth surfacing
  scope       String // what the review covered
  notes       String?
}

// Assistant transcript and audit trail. CLAUDE.md §9 rule 5 requires every
// AI interaction to be logged with the tools called and the records
// touched, and §11 requires that log to be append-only — nothing in the
// app updates or deletes these rows. Deliberately stores record *ids* and
// tool inputs, never tool result payloads: the audit question is "what did
// the assistant read and act on", and copying household figures into a
// second table would be a second place for client data to leak from.
model AiConversation {
  id           String      @id @default(cuid())
  advisorName  String // the acting advisor; a real User relation lands with auth (D-014)
  contextLabel String? // the route context chip in effect, e.g. "Ramirez Household"
  contextPath  String?
  createdAt    DateTime    @default(now())
  messages     AiMessage[]
  toolCalls    AiToolCall[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String // user | assistant
  text           String
  // Set when lib/ai/guardrails flagged the text (CLAUDE.md §9 rule 4).
  guardrailFlags String?
  createdAt      DateTime       @default(now())
}

model AiToolCall {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  toolName       String
  inputJson      String
  // Which records the call touched, comma-separated ids — the "records
  // touched" half of §9 rule 5.
  recordIds      String
  ok             Boolean
  errorMessage   String?
  durationMs     Int
  createdAt      DateTime       @default(now())
}

// Today's widget grid, per advisor (CLAUDE.md §5). Stored as JSON rather
// than a row per widget: the whole layout is written at once on every drag,
// read at once on every page load, and never queried by its parts — a
// normalised table would buy nothing and cost a transaction per drop.
//
// §5 also asks for a layout per breakpoint and an org default an admin can
// publish and lock. Neither is here: the app has one breakpoint and no
// roles (D-014). `advisorId` is unique, so this becomes per-user the moment
// advisors become users.
model DashboardLayout {
  id         String   @id @default(cuid())
  advisor    Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId  String   @unique
  // [{ i, x, y, w, h }] — the widget ids present and where they sit.
  // Absence of a widget id means the advisor removed it.
  layoutJson String
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Signals: watched indicators, the changes they record, and the alerts a
// change raises against specific households (M-demo item 3).
//
// The feed is simulated and says so on every surface — CLAUDE.md §13 forbids
// inventing tax thresholds or regulatory rules, and this audience spots an
// invented bracket instantly. What is real is the mechanism: a change runs
// every household profile through the rules in lib/calc/signals.ts, and each
// alert carries the reason this household matched.
model Indicator {
  id            String  @id @default(cuid())
  key           String  @unique // fed_funds_rate | equity_drawdown | rmd_age | ...
  name          String
  category      String // Rates | Market | Tax | Policy
  unit          String // % | pts | age | USD
  value         Float
  previousValue Float?
  // Where this number would come from in production. Always marked as a
  // fixture today; a real feed replaces the label, not the mechanism.
  sourceLabel   String
  updatedAt     DateTime          @updatedAt
  watches       IndicatorWatch[]
  changes       IndicatorChange[]
}

// An advisor watching an indicator, and how big a move they care about.
// Watching is per advisor because attention is: the advisor with the
// mortgage-heavy book cares about rates at a finer grain than one without.
model IndicatorWatch {
  id          String    @id @default(cuid())
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  indicatorId String
  advisor     Advisor   @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId   String
  // Smallest move worth a run, in the indicator's own unit.
  threshold   Float
  createdAt   DateTime  @default(now())

  @@unique([indicatorId, advisorId])
}

model IndicatorChange {
  id          String    @id @default(cuid())
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  indicatorId String
  fromValue   Float
  toValue     Float
  // What a human would say happened, e.g. "Simulated scenario: short rates
  // up 75bp over the quarter".
  note        String
  occurredAt  DateTime  @default(now())
  alerts      Alert[]
}

// One household, one reason. An alert that can't say why this household
// matched is indistinguishable from a guess, so `rationale` is required and
// is built from that household's own figures.
model Alert {
  id              String           @id @default(cuid())
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdId     String
  change          IndicatorChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)
  changeId        String?
  ruleKey         String // which rule matched, for tuning later
  severity        String // high | medium | low
  title           String
  rationale       String
  suggestedAction String
  // Where to go to act on it, e.g. "allocation".
  section         String?
  status          String           @default("open") // open | acknowledged | dismissed
  createdAt       DateTime         @default(now())
}
