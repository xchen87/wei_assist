{
  "name": "meridian",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @meridian/web dev",
    "build": "pnpm --filter @meridian/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @meridian/db push",
    "db:seed": "pnpm --filter @meridian/db seed",
    "db:studio": "pnpm --filter @meridian/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
